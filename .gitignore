# ===== M3U Playlist Processor — public repo ignore rules =====
# Publish the SOURCE + docs + examples + Dockerfile. Keep secrets, local
# databases, generated playlists, and private deployment out of git.

# ---- Local scratch / QA scratch (internal-only specs, never public) ----
tmp/

# ---- Real feed list (private URLs). Public version is examples/feeds.example.txt ----
feeds.txt

# ---- Private runtime config (public version is examples/config.example.yaml) ----
config.yaml
*.local.yaml

# ---- Secrets / credentials (NEVER commit) ----
.env
*.env
config/.env
**/.env
auth*.txt
webui_token.txt
soft-data/

# ---- Local database (sqlite) ----
*.db
*.db-shm
*.db-wal
data/
prod/data/
backups/
**/backups/

# ---- Generated output playlists ----
# IMPORTANT: the repo-root `out/` IS the public, intentionally-published
# playlist folder (copied from prod/out after a run fully completes). It is
# tracked on purpose. Only the PRIVATE locations are ignored.
out/.publish.lock
out/.last_publish_hash
prod/out/
output/
playlists/
prod/playlists/

# ---- Private production deployment (absolute paths, real feeds) ----
prod/
_deploy*/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Logs ----
logs/
*.log

# ---- Internal-only specs / QA plans (not for public) ----
requirement/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
