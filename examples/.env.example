# GitHub publish credential + target repo.
# Copy this file to `.env` (or mount it as /config/.env in Docker) and fill in.
# NEVER commit the real `.env` — it holds your PAT.

# Your GitHub username (line-1 of the legacy auth file format)
GITHUB_USER=your-github-username

# A fine-grained or classic Personal Access Token with `contents:write` (repo) scope
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public repo the generated playlists are pushed to (out/ folder).
# https or ssh both work; token auth uses https.
GITHUB_REPO_URL=https://github.com/your-github-username/iptvshifter.git

# Optional: path to a 2-line auth file (line1=user, line2=PAT) instead of the
# two vars above. If set, GITHUB_USER/GITHUB_PAT are ignored.
# GITHUB_AUTH_FILE=/config/.env
