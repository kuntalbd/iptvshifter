# Docker build context exclusions — keep the image lean and secret-free.
.git
.gitignore
.env
*.env
**/.env
*.db
*.db-shm
*.db-wal
data/
prod/
out/
output/
playlists/
logs/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
requirement/
docs/
.github/
examples/
tests/
.config.yaml
webui_token.txt

